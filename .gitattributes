# Source files: enforce LF line endings, treat as text.
# This repo is source-only; derived artifacts are gitignored and
# rebuilt via the Makefile (see HOWTO.md and scripts/).

*.md          text eol=lf
*.txt         text eol=lf
*.csv         text eol=lf
*.py          text eol=lf
*.FCMacro     text eol=lf
*.sh          text eol=lf
*.mmd         text eol=lf
*.drawio      text eol=lf
*.kicad_pro   text eol=lf
*.kicad_sch   text eol=lf
*.kicad_sym   text eol=lf
*.kicad_pcb   text eol=lf
sym-lib-table text eol=lf
*.gitignore   text eol=lf
*.gitattributes text eol=lf
Makefile      text eol=lf

# Windows install script — Windows-native CRLF
*.ps1         text eol=crlf
*.bat         text eol=crlf
*.cmd         text eol=crlf
