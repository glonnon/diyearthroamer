# Git LFS — binary CAD, mesh, render, and document outputs.
# See REQUIREMENTS.md §24 for file format strategy.

# CAD natives
*.FCStd        filter=lfs diff=lfs merge=lfs -text
*.FCStd1       filter=lfs diff=lfs merge=lfs -text
*.FCBak        filter=lfs diff=lfs merge=lfs -text
*.f3d          filter=lfs diff=lfs merge=lfs -text
*.f3z          filter=lfs diff=lfs merge=lfs -text
*.sldprt       filter=lfs diff=lfs merge=lfs -text
*.sldasm       filter=lfs diff=lfs merge=lfs -text
*.slddrw       filter=lfs diff=lfs merge=lfs -text

# Neutral 3D
*.step         filter=lfs diff=lfs merge=lfs -text
*.stp          filter=lfs diff=lfs merge=lfs -text
*.iges         filter=lfs diff=lfs merge=lfs -text
*.igs          filter=lfs diff=lfs merge=lfs -text

# Mesh
*.stl          filter=lfs diff=lfs merge=lfs -text
*.glb          filter=lfs diff=lfs merge=lfs -text
*.gltf         filter=lfs diff=lfs merge=lfs -text
*.obj          filter=lfs diff=lfs merge=lfs -text
*.fbx          filter=lfs diff=lfs merge=lfs -text
*.ply          filter=lfs diff=lfs merge=lfs -text

# 2D / drawings
*.dxf          filter=lfs diff=lfs merge=lfs -text
*.dwg          filter=lfs diff=lfs merge=lfs -text
*.pdf          filter=lfs diff=lfs merge=lfs -text

# Render / image
*.png          filter=lfs diff=lfs merge=lfs -text
*.jpg          filter=lfs diff=lfs merge=lfs -text
*.jpeg         filter=lfs diff=lfs merge=lfs -text
*.tif          filter=lfs diff=lfs merge=lfs -text
*.tiff         filter=lfs diff=lfs merge=lfs -text
*.exr          filter=lfs diff=lfs merge=lfs -text
*.psd          filter=lfs diff=lfs merge=lfs -text

# Blender
*.blend        filter=lfs diff=lfs merge=lfs -text
*.blend1       filter=lfs diff=lfs merge=lfs -text

# KiCad (mostly text, but binary footprints / 3D models go LFS)
*.kicad_pcb    filter=lfs diff=lfs merge=lfs -text
*.kicad_sch    filter=lfs diff=lfs merge=lfs -text
*.lib          filter=lfs diff=lfs merge=lfs -text
*.mod          filter=lfs diff=lfs merge=lfs -text
*.wrl          filter=lfs diff=lfs merge=lfs -text
*.wings        filter=lfs diff=lfs merge=lfs -text

# CAM / G-code
*.nc           filter=lfs diff=lfs merge=lfs -text
*.gcode        filter=lfs diff=lfs merge=lfs -text
*.tap          filter=lfs diff=lfs merge=lfs -text

# Office / archives that occasionally land here
*.xlsx         filter=lfs diff=lfs merge=lfs -text
*.ods          filter=lfs diff=lfs merge=lfs -text
*.zip          filter=lfs diff=lfs merge=lfs -text
*.7z           filter=lfs diff=lfs merge=lfs -text

# Force CSV/text/markdown to be diffable text
*.csv          text eol=lf
*.md           text eol=lf
*.txt          text eol=lf
*.drawio       text eol=lf
