# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*~

# FreeCAD lock + autosave
*.FCStd1
.~lock.*#
*~lock~*

# Blender autosaves
*.blend@
*.blend1
*.blend2

# KiCad cache / backups
*-backups/
*.bak
*.kicad_prl
fp-info-cache
sym-lib-table.bak

# KiCad generated exports (regenerate any time)
electrical/kicad/exports/

# Build / temp
/tmp/
/build/
/out/

# Generated master documents (regenerate with scripts/build-master-doc.py)
/MASTER.md
/MASTER.pdf
/MASTER.html

# Generated diagram SVGs (regenerate with scripts/render-diagrams.sh)
diagrams/*.svg

# Weight report CSVs (regenerate with scripts/weight-cg.py)
weight/axle-report*.csv

# Python venvs (for any helper scripts)
.venv/
__pycache__/
*.pyc
