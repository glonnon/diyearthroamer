# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*~

# Python
.venv/
__pycache__/
*.pyc

# ---------------------------------------------------------------------- #
# Derived artifacts — regenerate via Makefile (see HOWTO.md).
# Source files are .FCMacro (Python), .mmd, .kicad_*, .csv, .md, etc.
# Anything below this line is reproducible from those sources.
# ---------------------------------------------------------------------- #

# FreeCAD documents (rebuild from .FCMacro via `make cad`)
*.FCStd
*.FCStd1
*.FCBak
.~lock.*
*~lock~*

# Other CAD natives we never intend to keep (use STEP for exchange)
*.f3d
*.f3z
*.sldprt
*.sldasm
*.slddrw

# Neutral 3D exchange (regenerated from FreeCAD)
*.step
*.stp
*.iges
*.igs

# Mesh / web (regenerated)
*.stl
*.glb
*.gltf
*.obj
*.fbx
*.ply

# 2D vector / drawings (regenerated)
*.dxf
*.dwg

# CAM output
*.nc
*.gcode
*.tap

# Renders
*.exr
*.tif
*.tiff

# Blender (Blender scenes are derived from STEP via scripts; do not commit)
*.blend
*.blend1
*.blend2

# KiCad caches / backups (the .kicad_* source files are committed)
*-backups/
*.bak
*.kicad_prl
fp-info-cache
sym-lib-table.bak

# KiCad CLI exports
electrical/kicad/exports/

# Diagram SVG/PNG (regenerate with `make diagrams`)
diagrams/*.svg
diagrams/*.png

# Master document (regenerate with `make doc`)
/MASTER.md
/MASTER.pdf
/MASTER.html

# Weight reports (regenerate with `make weight`)
weight/axle-report*.csv

# Build outputs
/build/
/out/
/tmp/
