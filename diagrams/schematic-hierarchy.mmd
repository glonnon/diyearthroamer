%% KiCad hierarchical schematic structure
%% Render: mmdc -i diagrams/schematic-hierarchy.mmd -o diagrams/schematic-hierarchy.svg
%%{init: {'theme':'base','themeVariables':{'primaryColor':'#fff','primaryTextColor':'#000','primaryBorderColor':'#000','lineColor':'#1f2937','fontFamily':'Inter, system-ui, sans-serif','fontSize':'15px'}}}%%
flowchart TB
    classDef root fill:#fde68a,stroke:#78350f,stroke-width:3px,color:#000
    classDef power fill:#bfdbfe,stroke:#1e3a8a,stroke-width:2px,color:#000
    classDef ac fill:#fbcfe8,stroke:#831843,stroke-width:2px,color:#000
    classDef ctrl fill:#bbf7d0,stroke:#14532d,stroke-width:2px,color:#000

    Root[Root<br/>shore, alternator, battery, bus]:::root

    V48[48V_Bus<br/>Epoch x4, MultiPlus, MPPT, Mabru]:::power
    V24[24V_SubBus<br/>Orion XS, ANL 60A, fuse blocks]:::power
    V12[12V_Legacy<br/>24-12V, radio, sensors]:::power
    Solar[Solar<br/>4x 320W, combiner, gland]:::power

    AC[AC_Distribution<br/>Shore, EMS, Iso, load center]:::ac

    Lights[Lighting<br/>interior + exterior LED]:::ctrl
    HVAC[HVAC_Control<br/>Mabru, Webasto, MaxxAir, fans]:::ctrl
    Plumb[Plumbing_Control<br/>pump, UV, SeeLevel, heater pads]:::ctrl
    Lift[LiftBox_Control<br/>Linak x2, sync, interlocks]:::ctrl
    Comms[Comms_AV<br/>Starlink, Pepwave, USB-C PD, TV]:::ctrl

    Root --> V48
    Root --> V24
    Root --> V12
    Root --> Solar
    Root --> AC
    Root --> Lights
    Root --> HVAC
    Root --> Plumb
    Root --> Lift
    Root --> Comms
    V48 -. PV+/PV- .-> Solar
    V48 -. AC IN/OUT .-> AC
    V48 -. +24V .-> V24
    V24 -. +12V .-> V12
    V24 -. branches .-> Lights & HVAC & Plumb & Lift & Comms
